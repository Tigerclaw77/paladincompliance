# Paladin Compliance production environment template

# Site URLs
NEXT_PUBLIC_SITE_URL="https://www.paladincompliance.com"
NEXT_PUBLIC_APP_URL="https://www.paladincompliance.com"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Auth.js
AUTH_URL="https://www.paladincompliance.com"
NEXTAUTH_URL="https://www.paladincompliance.com"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Email magic links
# Resend SMTP: username is "resend"; password is a Resend API key.
EMAIL_SERVER="smtps://resend:re_replace_me@smtp.resend.com:465"
EMAIL_FROM="Paladin Compliance <security@your-domain.com>"
EMAIL_REPLY_TO="support@your-domain.com"
PALADIN_SUPPORT_EMAIL="support@your-domain.com"

# Internal admin access
PALADIN_ADMIN_EMAILS="admin@your-domain.com"

# Neon Postgres
# Use the pooled connection string for the app runtime.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Optional but recommended: use the direct connection string for Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Stripe
STRIPE_SECRET_KEY="sk_live_replace_me"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""

# Stripe catalog
# Product and Price IDs are centralized in src/lib/stripe/priceIds.ts
# and regenerated from prices.csv with `npm run stripe:price-ids`.

# Asset storage
# local and vercel-tmp are filesystem-backed. Use only for development or an explicit pilot exception.
PALADIN_STORAGE_DRIVER="vercel-tmp"
PALADIN_STORAGE_ROOT=""
PALADIN_ALLOW_EPHEMERAL_STORAGE="false"

# Reserved for future durable object storage adapters.
PALADIN_STORAGE_BUCKET=""
